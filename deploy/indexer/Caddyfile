# The Sepolia indexer's public face: api.paved.bal7hazar.com. Site block, imported by the main /etc/caddy/Caddyfile
# (docs/client/indexer-hosting.md, "Runbook: this VPS (Sepolia)"). No global options: the main Caddyfile is shared with other
# sites on this VPS and keeps its own. The client and the Storybook are served by Vercel (docs/client/f-release.md).
# Certificate: automatic (Let's Encrypt), once the name resolves here and 80/443 are reachable.

# --- the API: the indexer on loopback, nothing else ----------------------------------------------------------------
api.paved.bal7hazar.com {
	encode zstd gzip

	# Only reads: nothing here takes a body.
	request_body {
		max_size 1KB
	}

	header {
		X-Content-Type-Options nosniff
		-Server
		# No Access-Control-* here, ever: the indexer sets them from --allow-origin (https://paved.bal7hazar.com) and a
		# second value makes the browser refuse the answer. The proxy passes the Origin header through untouched.
	}

	# /v1/* only, GET only; anything else is a 404 or a 405 from here. The client sends simple GETs (no preflight), and an
	# OPTIONS would only reach the indexer to be answered 405.
	handle /v1/* {
		@write not method GET
		respond @write 405

		reverse_proxy 127.0.0.1:8787 {
			transport http {
				dial_timeout 2s
				response_header_timeout 15s
				read_timeout 15s
				write_timeout 15s
			}
			# The indexer sends cache-control: no-store, and its 503 JSON (loading, rewinding, halted) is passed through.
		}
	}
	handle {
		respond 404
	}
}
