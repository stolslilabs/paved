[Unit]
Description=Paved: per-address limit on new connections to 80/443 (nftables)
After=network-pre.target
Before=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /opt/paved-indexer/current/deploy/indexer/paved-ratelimit.nft
ExecStop=/usr/sbin/nft delete table inet paved_ratelimit

[Install]
WantedBy=multi-user.target
