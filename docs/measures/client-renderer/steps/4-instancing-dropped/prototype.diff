+class InstanceBatch {
+  mesh: THREE.InstancedMesh;
+  private slots: Array<{ index: number }> = [];
+
+  constructor(geometry: THREE.BufferGeometry, material: THREE.Material) {
+    this.mesh = new THREE.InstancedMesh(geometry, material, 8);
+    this.mesh.count = 0;
+    this.mesh.castShadow = true;
+    this.mesh.receiveShadow = true;
+  }
+
+  add(matrix: THREE.Matrix4): { index: number } {
+    if (this.slots.length >= this.mesh.instanceMatrix.count) this.grow();
+    const slot = { index: this.slots.length };
+    this.slots.push(slot);
+    this.mesh.setMatrixAt(slot.index, matrix);
+    this.mesh.count = this.slots.length;
+    this.mesh.instanceMatrix.needsUpdate = true;
+    this.mesh.boundingSphere = null;
+    return slot;
+  }
+
+  remove(slot: { index: number }): void {
+    const last = this.slots.pop()!;
+    if (last !== slot) {
+      const m = new THREE.Matrix4();
+      this.mesh.getMatrixAt(last.index, m);
+      this.mesh.setMatrixAt(slot.index, m);
+      last.index = slot.index;
+      this.slots[slot.index] = last;
+    }
+    this.mesh.count = this.slots.length;
+    this.mesh.instanceMatrix.needsUpdate = true;
+    this.mesh.boundingSphere = null;
+  }
+
+  private grow(): void {
+    const old = this.mesh;
+    const next = new THREE.InstancedMesh(old.geometry, old.material, old.instanceMatrix.count * 2);
+    next.castShadow = true;
+    next.receiveShadow = true;
+    next.instanceMatrix.array.set(old.instanceMatrix.array);
+    next.count = old.count;
+    old.parent?.add(next);
+    old.parent?.remove(old);
+    old.dispose();
+    this.mesh = next;
+  }
+}
