+  /** Moves the tile's meshes into instanced batches; its edge lines stay in the tile. */
+  private instance(container: THREE.Object3D): Array<{ batch: InstanceBatch; slot: { index: number } }> {
+    container.updateMatrix();
+    const out: Array<{ batch: InstanceBatch; slot: { index: number } }> = [];
+    const meshes: Array<{ mesh: THREE.Mesh; matrix: THREE.Matrix4 }> = [];
+    const walk = (obj: THREE.Object3D, parent: THREE.Matrix4) => {
+      obj.updateMatrix();
+      const m = new THREE.Matrix4().multiplyMatrices(parent, obj.matrix);
+      if (obj instanceof THREE.Mesh) meshes.push({ mesh: obj, matrix: m });
+      for (const c of obj.children) walk(c, m);
+    };
+    walk(container, new THREE.Matrix4());
+    for (const { mesh, matrix } of meshes) {
+      const material = mesh.material as THREE.Material;
+      const id = `${mesh.geometry.uuid}/${material.uuid}`;
+      let batch = this.batches.get(id);
+      if (!batch) {
+        batch = new InstanceBatch(mesh.geometry, material);
+        this.batches.set(id, batch);
+        this.batchGroup.add(batch.mesh);
+      }
+      out.push({ batch, slot: batch.add(matrix) });
+      // Keep the transform and the edge lines, drop the faces
+      const holder = new THREE.Object3D();
+      holder.position.copy(mesh.position);
+      holder.quaternion.copy(mesh.quaternion);
+      holder.scale.copy(mesh.scale);
+      holder.add(...mesh.children);
+      mesh.parent!.add(holder);
+      mesh.parent!.remove(mesh);
+    }
+    return out;
+  }
