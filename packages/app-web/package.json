{
  "name": "@paved/app-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "build:bench": "vite build -c vite.bench.config.ts --outDir dist-bench",
    "bench": "bun install --cwd ../../scripts/bench --frozen-lockfile && bun ../../scripts/bench/run.ts",
    "bench:p7": "bun run bench --profiles throttled && bun run bench --click --no-build && bun run bench --play"
  },
  "dependencies": {
    "@paved/game-core": "workspace:*",
    "@paved/chain": "workspace:*",
    "@paved/renderer": "workspace:*",
    "@paved/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "starknet": "^8.1.2",
    "tamagui": "2.7.7",
    "@tamagui/core": "2.7.7",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.3"
  }
}
