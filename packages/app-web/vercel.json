{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "cd ../.. && bun run build --filter @paved/app-web",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "VITE_NETWORK": "sepolia",
      "VITE_INDEXER_URL": "https://api.paved.bal7hazar.com",
      "VITE_RPC_URL": "https://api.cartridge.gg/x/starknet/sepolia/rpc/v0_10"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/|models/|draco/|.*\\.[A-Za-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/((?!tiles/).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/renderer-assets/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/renderer-assets/tiles/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(|index.html|renderer-assets/manifest.json)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
