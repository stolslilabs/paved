{
  "name": "@paved/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fa-subset.ts --check && node scripts/game-icons.ts --check && node scripts/league-crests.ts --check && node scripts/coins.ts --check && node scripts/chest-art.ts --check && tsc -b && vite build && node scripts/bundle-budget.ts",
    "fa-subset": "node scripts/fa-subset.ts",
    "fa-subset-check": "node scripts/fa-subset.ts --check",
    "game-icons": "node scripts/game-icons.ts",
    "league-crests": "node scripts/league-crests.ts",
    "coins": "node scripts/coins.ts",
    "chest-art": "node scripts/chest-art.ts",
    "bundle-budget": "node scripts/bundle-budget.ts",
    "test": "vitest run",
    "e2e": "tsc -p e2e/tsconfig.json && vitest run --config e2e/vitest.config.ts",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "node scripts/storybook-static-dirs.ts && storybook build -o storybook-static && node scripts/storybook-guard.ts",
    "wrap-sweep": "node scripts/wrap-sweep.ts && node scripts/locale-check.ts",
    "header-sweep": "node scripts/header-sweep.ts",
    "locale-check": "node scripts/locale-check.ts",
    "mobile-feel": "node scripts/mobile-feel.ts"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "5.3.0",
    "@fontsource/almendra": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@paved/chain": "workspace:*",
    "@paved/game-core": "workspace:*",
    "@paved/renderer": "workspace:*",
    "@tanstack/react-query": "5.104.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "motion": "14.0.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "sonner": "2.0.8",
    "starknet": "8.9.2",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "meshoptimizer": "1.1.1",
    "playwright-core": "1.63.0",
    "shadcn": "4.21.4",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
