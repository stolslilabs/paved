{
  "name": "@paved/game-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./e2e": {
      "import": "./dist/social/e2e.js",
      "types": "./dist/social/e2e.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "generate:tables": "bun scripts/generate-tables.ts",
    "generate:parity": "bun scripts/transcribe-goldens.ts"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "1.7.0",
    "@noble/hashes": "1.6.1",
    "@scure/starknet": "1.1.0"
  },
  "devDependencies": {
    "vitest": "^5.0.3",
    "typescript": "^7.0.2"
  }
}
