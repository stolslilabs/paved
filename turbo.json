{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["PAVED_TEST_SLOW"]
    },
    "lint": {},
    "clean": {
      "cache": false
    }
  }
}
