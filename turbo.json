{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/contracts/abis/**",
        "$TURBO_ROOT$/contracts/deployments/**",
        "$TURBO_ROOT$/contracts/fixtures/**",
        "$TURBO_ROOT$/contracts/src/**",
        "$TURBO_ROOT$/scripts/**"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/contracts/abis/**",
        "$TURBO_ROOT$/contracts/deployments/**",
        "$TURBO_ROOT$/contracts/fixtures/**",
        "$TURBO_ROOT$/contracts/src/**",
        "$TURBO_ROOT$/scripts/**"
      ],
      "env": ["PAVED_TEST_SLOW"]
    },
    "lint": {},
    "clean": {
      "cache": false
    }
  }
}
