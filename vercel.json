{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "installCommand": "bun install --frozen-lockfile",
  "ignoreCommand": "[ -f scripts/vercel/ignore-build.sh ] && sh scripts/vercel/ignore-build.sh storybook || exit 1",
  "buildCommand": "bun run build --filter @paved/app^... && NODE_OPTIONS=--max-old-space-size=3072 bun run --cwd packages/app build-storybook",
  "outputDirectory": "packages/app/storybook-static",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/renderer-assets/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/renderer-assets/tiles/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(|index.html|iframe.html|index.json|project.json|renderer-assets/manifest.json)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
